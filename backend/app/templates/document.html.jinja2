<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ doc_type }} {{ number }}</title>
<style>
  @page { size: A4; margin: 16mm; }
  * { box-sizing: border-box; }
  body {
    font-family: {{ font_family_css }};
    font-size: {{ '9.5pt' if config.font_size == 'small' else '12pt' if config.font_size == 'large' else '10.5pt' }};
    line-height: 1.45;
    color: #1e293b;
    margin: 0;
    position: relative;
  }
  .accent { color: {{ accent_color }}; }
  .primary { color: {{ primary_color }}; }

  /* Header — a table, not flex: xhtml2pdf doesn't support flexbox, and a
     two-column table is its strongest layout mode. Classic: white
     background, colored heading text, bottom border. Modern: a full-width
     colored band with white text — see the layout_preset block below for
     the override. */
  table.header { width: 100%; border-collapse: collapse; margin-bottom: 18px; border-bottom: 3px solid {{ primary_color }}; }
  table.header td { vertical-align: top; padding-bottom: 12px; }
  table.header td.header-right { text-align: right; }
  .logo-line { margin: 0 0 4px; }
  .logo { max-height: 60px; max-width: 200px; object-fit: contain; }
  .biz-name { font-size: 1.4em; font-weight: bold; margin: 0 0 2px; }
  .biz-line { font-size: 0.85em; color: #475569; margin: 0 0 2px; }
  .doc-title {
    font-size: 1.9em;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.3pt;
    color: {{ primary_color }};
    text-align: right;
    margin: 0 0 4px;
  }
  .doc-meta { font-size: 0.9em; text-align: right; color: #475569; }
  .doc-meta td { padding: 1px 0 1px 12px; text-align: right; }

  {% if config.layout_preset == 'modern' %}
  table.header { border-bottom: none; }
  table.header td { background: {{ primary_color }}; padding: 16px 18px; }
  table.header .biz-name, table.header .doc-title { color: white; }
  table.header .biz-line, table.header .doc-meta, table.header .doc-meta td { color: #e2e8f0; }
  table.header .status-badge { background: white; color: {{ primary_color }}; }
  {% endif %}

  /* Bill To / From — also a table now (was flex; xhtml2pdf renders it
     stacked instead of side-by-side, which broke this block specifically). */
  table.parties { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
  table.parties td { width: 50%; vertical-align: top; }
  table.parties td.party-right { text-align: right; }
  .party-label {
    font-size: 0.76em; text-transform: uppercase; letter-spacing: 0.5pt; color: #94a3b8; font-weight: bold;
    margin-bottom: 5px;
    {% if config.layout_preset == 'modern' %}border-left: 3px solid {{ accent_color }}; padding-left: 6px;{% endif %}
  }
  .party-right .party-label { {% if config.layout_preset == 'modern' %}border-left: none; border-right: 3px solid {{ accent_color }}; padding-left: 0; padding-right: 6px;{% endif %} }
  .party-name { font-weight: bold; font-size: 1.05em; margin-bottom: 4px; }
  .party-line { font-size: 0.9em; color: #334155; margin: 0 0 1px; }
  table.items { width: 100%; border-collapse: collapse; margin-bottom: 18px; table-layout: fixed; }
  table.items th:first-child, table.items td:first-child { width: 34%; }
  table.items th {
    background: {{ primary_color }};
    color: white;
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.4pt;
    padding: 8px 10px;
    text-align: left;
  }
  table.items th.num, table.items td.num { text-align: right; }
  table.items td {
    padding: 8px 10px;
    font-size: 0.9em;
    line-height: 1.4;
    word-wrap: break-word;
    {% if config.table_style == 'bordered' %}border: 1px solid #cbd5e1;{% else %}border-bottom: 1px solid #e2e8f0;{% endif %}
  }
  {% if config.table_style == 'striped' %}
  table.items tbody tr:nth-child(even) { background: #f8fafc; }
  {% endif %}
  .totals { width: 260px; margin-left: auto; font-size: 0.95em; }
  .totals tr td { padding: 3px 8px; }
  .totals td.label { color: #64748b; }
  .totals td.value { text-align: right; }
  .totals tr.grand td { border-top: 2px solid #1e293b; font-weight: bold; font-size: 1.15em; padding-top: 6px; }
  .totals tr.discount td { color: {{ accent_color }}; }
  {% if config.layout_preset == 'modern' %}
  {# xhtml2pdf applies a border declared on a multi-row <table> to every
     row, not just the table's own edge (legacy border="1"-style behavior —
     confirmed by testing: a border on .totals here drew a line above EVERY
     row, not just the top). The single-row table.header above doesn't show
     this because it only has one row to begin with. Fix: put the border on
     the first row's cells specifically, not the table. #}
  .totals tr:first-child td { border-top: 2px solid {{ accent_color }}; padding-top: 8px; }
  .totals tr td { padding: 5px 10px; }
  .totals tr.grand td { background: {{ primary_color }}; color: white; border-top: none; }
  .totals tr.grand td.label { color: white; }
  {% endif %}
  .amount-words { margin-top: 10px; font-size: 0.85em; font-style: italic; color: #475569; text-align: right; }
  table.notes-terms { width: 100%; border-collapse: collapse; margin-top: 22px; font-size: 0.85em; }
  table.notes-terms td { width: 50%; vertical-align: top; padding-right: 12px; }
  .notes-terms .label { font-size: 0.76em; text-transform: uppercase; letter-spacing: 0.5pt; color: #94a3b8; font-weight: bold; margin-bottom: 4px; }
  .notes-terms .body-text { line-height: 1.5; }
  .bank { margin-top: 16px; font-size: 0.85em; border: 1px solid #e2e8f0; padding: 12px; border-radius: 4px; }
  .bank .label { font-size: 0.76em; text-transform: uppercase; letter-spacing: 0.5pt; color: #94a3b8; font-weight: bold; margin-bottom: 5px; }
  .bank .body-text { line-height: 1.6; }
  .signature { margin-top: 40px; font-size: 0.85em; }
  .signature .line { width: 220px; border-top: 1px solid #334155; padding-top: 4px; color: #64748b; }
  .footer { margin-top: 24px; text-align: center; font-size: 0.8em; color: #94a3b8; }
  .status-badge {
    display: inline-block; padding: 3px 11px; border-radius: 10px;
    font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.4pt; font-weight: bold;
    background: #f1f5f9; color: {{ accent_color }};
  }

  {% if config.layout_preset == 'minimal' %}
  {# Minimal: no borders/fills, just generous whitespace and lightweight
     type — overrides the base (non-preset) rules above, which is safe
     since these declarations come later in the stylesheet. #}
  table.header { border-bottom: none; }
  table.header td { padding-bottom: 20px; }
  .biz-name { font-weight: normal; }
  table.items th { background: white; color: #64748b; border-bottom: 2px solid #1e293b; font-weight: normal; }
  table.items td { border-bottom: 1px solid #f8fafc; padding: 10px; }
  .status-badge { background: white; border: 1px solid #e2e8f0; }
  .totals tr.grand td { border-top: 2px solid #1e293b; background: white; color: #1e293b; }
  .totals tr.grand td.label { color: #1e293b; }
  {% endif %}
</style>
</head>
<body>

  <table class="header">
    <tr>
      <td class="header-left">
        {% if logo_uri %}<p class="logo-line" style="text-align: {{ 'right' if config.logo_position == 'right' else 'center' if config.logo_position == 'center' else 'left' }};"><img class="logo" src="{{ logo_uri }}" /></p>{% endif %}
        <p class="biz-name">{{ business.legal_name or business.name }}</p>
        {% if business.address_line1 %}<p class="biz-line">{{ business.address_line1 }}{% if business.address_line2 %}, {{ business.address_line2 }}{% endif %}</p>{% endif %}
        {% if business.city or business.country %}<p class="biz-line">{{ [business.city, business.state, business.country] | select | join(', ') }}</p>{% endif %}
        {% if business.phone %}<p class="biz-line">Tel: {{ business.phone_code or '' }} {{ business.phone }}{% if business.email %} &middot; {{ business.email }}{% endif %}</p>{% endif %}
        {% if business.tax_id %}<p class="biz-line">Tax ID: {{ business.tax_id }}{% if business.cr_no %} &middot; CR No: {{ business.cr_no }}{% endif %}</p>{% endif %}
      </td>
      <td class="header-right">
        <p class="doc-title">{{ doc_type }}</p>
        <table class="doc-meta">
          <tr><td>No.</td><td><strong>{{ number }}</strong></td></tr>
          <tr><td>Date</td><td>{{ doc_date }}</td></tr>
          {% if due_date %}<tr><td>{{ due_label }}</td><td>{{ due_date }}</td></tr>{% endif %}
          <tr><td>Status</td><td><span class="status-badge">{{ status }}</span></td></tr>
        </table>
      </td>
    </tr>
  </table>

  <table class="parties">
    <tr>
      <td class="party-left">
        <p class="party-label">Bill To</p>
        <p class="party-name">{{ customer.name }}</p>
        {% if employee %}<p class="party-line">Attn: {{ employee.name }}</p>{% endif %}
        {% if 'address' in config.bill_to_fields and customer.address_line1 %}<p class="party-line">{{ customer.address_line1 }}{% if customer.address_line2 %}, {{ customer.address_line2 }}{% endif %}</p>{% endif %}
        {% if 'address' in config.bill_to_fields and (customer.city or customer.country) %}<p class="party-line">{{ [customer.city, customer.state, customer.country] | select | join(', ') }}</p>{% endif %}
        {% if 'phone' in config.bill_to_fields and customer.phone %}<p class="party-line">Tel: {{ customer.phone_code or '' }} {{ customer.phone }}</p>{% endif %}
        {% if 'email' in config.bill_to_fields and customer.email %}<p class="party-line">{{ customer.email }}</p>{% endif %}
        {% if 'tax_id' in config.bill_to_fields and customer.id_value %}<p class="party-line">{{ 'Tax/VAT No' if customer.id_kind == 'vat_tax' else 'National ID' }}: {{ customer.id_value }}</p>{% endif %}
      </td>
      <td class="party-right">
        {% if config.show_sender_block %}
        <p class="party-label">From</p>
        <p class="party-name">{{ business.name }}</p>
        {% endif %}
      </td>
    </tr>
  </table>

  <table class="items">
    <thead>
      <tr>
        <th>Description</th>
        <th class="num">Qty</th>
        <th class="num">Unit price</th>
        <th class="num">Discount</th>
        {% if show_govt_fee %}<th class="num">Govt. fee</th>{% endif %}
        <th class="num">VAT %</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      {% for item in items %}
      <tr>
        <td>{{ item.description }}</td>
        <td class="num">{{ item.qty }}</td>
        <td class="num">{{ '%.2f' | format(item.unit_price) }}</td>
        <td class="num">{{ '%.2f' | format(item.discount) }}</td>
        {% if show_govt_fee %}<td class="num">{{ '%.2f' | format(item.govt_fee * item.qty) }}</td>{% endif %}
        <td class="num">{{ '%.2f' | format(item.vat_rate) }}%</td>
        <td class="num">{{ '%.2f' | format(item.line_total) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <table class="totals">
    <tr><td class="label">Subtotal</td><td class="value">{{ currency }} {{ '%.2f' | format(subtotal) }}</td></tr>
    {% if discount_total %}<tr class="discount"><td class="label">Discount{% if coupon_code %} ({{ coupon_code }}){% endif %}</td><td class="value">-{{ currency }} {{ '%.2f' | format(discount_total) }}</td></tr>{% endif %}
    {% if config.show_tax_breakdown %}<tr><td class="label">VAT</td><td class="value">{{ currency }} {{ '%.2f' | format(vat_total) }}</td></tr>{% endif %}
    {% if show_govt_fee and govt_fee_total %}<tr><td class="label">Government fees</td><td class="value">{{ currency }} {{ '%.2f' | format(govt_fee_total) }}</td></tr>{% endif %}
    <tr class="grand"><td class="label">Total</td><td class="value">{{ currency }} {{ '%.2f' | format(grand_total) }}</td></tr>
    {% if amount_paid %}
    <tr><td class="label">Paid</td><td class="value">{{ currency }} {{ '%.2f' | format(amount_paid) }}</td></tr>
    <tr><td class="label">Balance due</td><td class="value">{{ currency }} {{ '%.2f' | format(grand_total - amount_paid) }}</td></tr>
    {% endif %}
  </table>

  {% if amount_in_words %}<p class="amount-words">{{ amount_in_words }}</p>{% endif %}

  {% if (config.show_notes and notes) or (config.show_terms and terms) %}
  <table class="notes-terms">
    <tr>
      <td>{% if config.show_notes and notes %}<p class="label">Notes</p><p class="body-text">{{ notes }}</p>{% endif %}</td>
      <td>{% if config.show_terms and terms %}<p class="label">Terms & Conditions</p><p class="body-text">{{ terms }}</p>{% endif %}</td>
    </tr>
  </table>
  {% endif %}

  {% if show_bank_details and business.bank_iban_or_no %}
  <div class="bank">
    <p class="label">Bank Details</p>
    <p class="body-text">{{ business.bank_name }} &middot; {{ business.bank_account_name }}<br/>
    IBAN/Account No: {{ business.bank_iban_or_no }}{% if business.bank_swift %} &middot; SWIFT: {{ business.bank_swift }}{% endif %}</p>
  </div>
  {% endif %}

  {% if config.show_signature %}
  <div class="signature">
    <div class="line">Authorized Signature</div>
  </div>
  {% endif %}

  <div class="footer">
    {% if business.website %}{{ business.website }} &middot; {% endif %}Generated by {{ business.name }}
  </div>

</body>
</html>
