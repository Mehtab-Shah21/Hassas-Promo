# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.db
*.sqlite3

# Per-install JWT signing secret (auto-generated, see app/core/config.py) --
# must NEVER be committed: anyone with it can forge a login token for any
# user, including a superadmin, on any install that happens to reuse it.
backend/secret.key

# Full-data backups (database + every uploaded file, zipped) -- as sensitive
# as the live database itself and never something source control should hold.
backend/backups/

# Uploaded files (logos etc.) - not source, but keep the folder via .gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Frontend production build, copied here for the packaged desktop server to
# serve statically (see app/core/config.frontend_dist_dir) -- a build
# artifact, not source; packaging/build_desktop.ps1 regenerates it.
backend/frontend_dist/

# Desktop packaging build output (backend/dist, frontend/dist already
# covered by the unanchored dist/ rule below)
backend/build/
installer/Output/

# Node
node_modules/
dist/
.vite/

# Env
# frontend/.env is intentionally tracked — it only holds the non-secret
# admin-install default VITE_API_URL=http://localhost:8000, not credentials.
.env.local
backend/.env

# IDE
.vscode/
.idea/

# Claude Code's own local project config (dev-server launch settings, lock
# files) -- machine-specific tooling, not part of the application.
.claude/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
